[Interface]
Address = {{ wireguard_server_cidr }}
ListenPort = {{ wireguard_port }}
PrivateKey = {{ wireguard_private_key }}
SaveConfig = false

{% for peer in wireguard_peers %}
[Peer]
# {{ peer.name | default('peer') }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.preshared_key is defined %}PresharedKey = {{ peer.preshared_key }}
{% endif %}{% if peer.persistent_keepalive is defined %}PersistentKeepalive = {{ peer.persistent_keepalive }}
{% endif %}

{% endfor %}
